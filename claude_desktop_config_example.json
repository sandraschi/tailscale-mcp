{
  "mcpServers": {
    "tailscale-mcp": {
      "command": "python",
      "args": ["-m", "tailscalemcp"],
      "env": {
        "PYTHONPATH": "src",
        "TAILSCALE_API_KEY": "tskey-api-REPLACE-WITH-YOUR-KEY",
        "TAILSCALE_TAILNET": "your-tailnet-id",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}

